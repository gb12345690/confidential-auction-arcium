# Built files and artifacts (Rust/Anchor and Frontend)
/target
/dist
/build

# Environment files (NEVER commit secrets!)
.env
.env.*

# Anchor or Solana artifacts
/.anchor
*.log
/coverage

# Node modules (if you have a frontend or TS client)
/node_modules
/client/node_modules

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local keypairs and config (never commit private keys!)
# These patterns catch all Solana/Anchor keypair files
*.json
!package.json
!*package.json # Ensures package.json is NEVER ignored
*.keypair
*.wal

# Cache and temporary files
/.cache
/.pnp*
.swp
*.local

# Package Manager lock files (These should generally be committed to ensure reproducible builds)
# yarn.lock (REMOVED from ignore list)
# package-lock.json (REMOVED from ignore list)
npm-debug.log

# Ignore docs build output (if any)
docs/.vuepress/dist
